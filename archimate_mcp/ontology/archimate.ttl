# --- ingestion object properties ---
:hasElement a owl:ObjectProperty ;
    rdfs:label "has element" ;
    rdfs:comment "Links an :ArchimateModel to an :ArchimateElement it owns." ;
    rdfs:domain :ArchimateModel ;
    rdfs:range :ArchimateElement .

:hasView a owl:ObjectProperty ;
    rdfs:label "has view" ;
    rdfs:comment "Links an :ArchimateModel to one of its :ArchimateView diagrams." ;
    rdfs:domain :ArchimateModel ;
    rdfs:range :ArchimateView .

:depictsElement a owl:ObjectProperty ;
    rdfs:label "depicts element" ;
    rdfs:comment "Links an :ArchimateView to an :ArchimateElement it visualises." ;
    rdfs:domain :ArchimateView ;
    rdfs:range :ArchimateElement .

:relSource a owl:ObjectProperty ;
    rdfs:label "relationship source" ;
    rdfs:comment "Links a reified :ArchimateRelationship to its source :ArchimateElement." ;
    rdfs:domain :ArchimateRelationship ;
    rdfs:range :ArchimateElement .

:relTarget a owl:ObjectProperty ;
    rdfs:label "relationship target" ;
    rdfs:comment "Links a reified :ArchimateRelationship to its target :ArchimateElement." ;
    rdfs:domain :ArchimateRelationship ;
    rdfs:range :ArchimateElement .

:archimateType a owl:DatatypeProperty ;
    rdfs:label "archimate type" ;
    rdfs:comment "The ArchiMate 3.x concept type name of an element or relationship (e.g. 'ApplicationComponent', 'Serving')." ;
    rdfs:range xsd:string .

:archimateLayer a owl:DatatypeProperty ;
    rdfs:label "archimate layer" ;
    rdfs:comment "The ArchiMate layer of an element (Business, Application, Technology, ...)." ;
    rdfs:range xsd:string .


# --- ArchiMate relationship types as object properties ---
:relAccess a owl:ObjectProperty ;
    rdfs:label "access" ;
    rdfs:comment "ArchiMate Access relationship: a behaviour element accesses a data/object element." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
:relAggregation a owl:ObjectProperty ;
    rdfs:label "aggregation" ;
    rdfs:comment "ArchiMate Aggregation relationship: whole aggregates a part (weak ownership)." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
:relAssignment a owl:ObjectProperty ;
    rdfs:label "assignment" ;
    rdfs:comment "ArchiMate Assignment relationship: an active structure element is assigned to behaviour/an interface." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
:relAssociation a owl:ObjectProperty ;
    rdfs:label "association" ;
    rdfs:comment "ArchiMate Association relationship: an unspecified association between two elements." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
:relComposition a owl:ObjectProperty ;
    rdfs:label "composition" ;
    rdfs:comment "ArchiMate Composition relationship: whole is composed of a part (strong ownership)." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
:relFlow a owl:ObjectProperty ;
    rdfs:label "flow" ;
    rdfs:comment "ArchiMate Flow relationship: a transfer (of information/value) from one element to another." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
:relInfluence a owl:ObjectProperty ;
    rdfs:label "influence" ;
    rdfs:comment "ArchiMate Influence relationship: an element influences a motivation element." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
:relRealization a owl:ObjectProperty ;
    rdfs:label "realization" ;
    rdfs:comment "ArchiMate Realization relationship: a concrete element realizes a more abstract one (service/requirement)." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
:relServing a owl:ObjectProperty ;
    rdfs:label "serving" ;
    rdfs:comment "ArchiMate Serving relationship: an element serves (provides functionality to) another." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
:relSpecialization a owl:ObjectProperty ;
    rdfs:label "specialization" ;
    rdfs:comment "ArchiMate Specialization relationship: an element is a specialization (subtype) of another." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
:relTriggering a owl:ObjectProperty ;
    rdfs:label "triggering" ;
    rdfs:comment "ArchiMate Triggering relationship: a temporal/causal trigger from one behaviour to the next." ;
    rdfs:domain :ArchimateElement ;
    rdfs:range :ArchimateElement .
