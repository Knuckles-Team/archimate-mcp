@prefix fibo-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-org: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <http://knuckles.team/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:BusinessTask a owl:Class ;
    rdfs:label "Business Task" ;
    rdfs:comment """A unit of business behaviour within a process (e.g. a Camunda
    user/service task). A BusinessTask is part of a BusinessProcess.""" ;
    rdfs:subClassOf :BusinessProcess .

:Change rdfs:subClassOf :BusinessProcess .

:Customer rdfs:subClassOf :BusinessActor .

:Employee rdfs:subClassOf :BusinessActor .

:Incident rdfs:subClassOf :ApplicationEvent ;
    owl:equivalentClass :ErpNextIssue .

:Person rdfs:subClassOf :BusinessActor .

:Playbook rdfs:subClassOf :BusinessProcess .

:flowsTo a owl:ObjectProperty ;
    rdfs:comment """BPMN sequence-flow usage (CONCEPT:KG-2.53): connects one
    :BusinessTask of a :BusinessProcess to the next (FLOWS_TO in the LPG),
    lifted from each process definition's BPMN 2.0 XML by the Camunda
    extractor; gateway branching appears as multiple flowsTo assertions whose
    LPG edges carry the branch's conditionExpression as a 'condition'
    property. The property is defined in ontology_egeria.ttl and deliberately
    stays domain/range-free here: it also carries Egeria asset→process data
    lineage, so asserting rdfs:domain/range :BusinessTask would let DL
    reasoning misclassify lineage assets as business tasks.""" ;
    rdfs:seeAlso <https://www.omg.org/spec/BPMN/20100524/MODEL> .

<http://knuckles.team/kg/archimate> a owl:Ontology ;
    rdfs:label "ArchiMate Canonical Upper Ontology & Vendor Crosswalk" ;
    rdfs:comment """Vendor-neutral ArchiMate 3.2 anchor concepts plus the
    cross-vendor crosswalk that makes enterprise systems interchangeable at the
    reasoning level. Each per-system class (ServiceNow :Incident, ERPNext
    :ErpNextIssue, Camunda :BusinessProcess/:BusinessTask, ...) is related by
    rdfs:subClassOf / owl:equivalentClass to one canonical concept, so a single
    SPARQL/Cypher query resolves all sources regardless of which vendor tool a
    client runs. Reasoning (owlready2/HermiT via core/owl_bridge.py) propagates
    rdf:type along these axioms onto the canonical concepts.

    All classes share the single namespace http://knuckles.team/kg# — this file
    only DEFINES classes not declared elsewhere (:ApplicationEvent, :BusinessTask,
    :BusinessActor) and ADDS crosswalk axioms onto classes defined in sibling
    ontologies (:Incident/:Change in ontology_servicenow.ttl;
    :Employee/:Customer/:ErpNextIssue in ontology_erpnext.ttl;
    :BusinessProcess/:ApplicationComponent in ontology_quant.ttl;
    :BusinessCapability in ontology_leanix.ttl). It never redefines them.

    CONCEPT:KG-2.9 — Enterprise OS vendor-neutral ontology.""" ;
    owl:imports <http://knuckles.team/kg> .

:ErpNextIssue rdfs:subClassOf :ApplicationEvent .

:ApplicationEvent a owl:Class ;
    rdfs:label "Application Event" ;
    rdfs:comment """Canonical ArchiMate 3.2 Application-layer event: an
    ITSM-style state change such as an unplanned interruption (incident). The
    vendor-neutral anchor that ServiceNow incidents, ERPNext issues, and Camunda
    process incidents all resolve to.""" ;
    rdfs:seeAlso <https://pubs.opengroup.org/architecture/archimate3-doc/chap09.html> .

:BusinessActor a owl:Class ;
    rdfs:label "Business Actor" ;
    rdfs:comment """Canonical ArchiMate Business Actor: a person or organizational
    entity that performs behaviour. The anchor that ERPNext Employees/Customers
    and ITSM Persons resolve to.""" ;
    rdfs:seeAlso <https://pubs.opengroup.org/architecture/archimate3-doc/chap08.html> .


# =========================================================================== #
# ArchiMate model-native ingestion classes (CONCEPT:AU-KG.ingest.enterprise-source-extractor)
# ---------------------------------------------------------------------------
# The archimate-mcp connector natively pushes every element, relationship and
# view of an ArchiMate Open Exchange model into the KG as typed OWL nodes. Node
# ``type`` values are the ArchiMate 3.x element-type names below (all subclasses
# of :ArchimateElement, grouped by layer), so a single query resolves elements
# across every ingested model. Ids follow ``archimate:<class>:<extId>``.
# =========================================================================== #

:ArchimateElement a owl:Class ;
    rdfs:label "ArchiMate Element" ;
    rdfs:comment """Root of the ArchiMate 3.x concept taxonomy: any node of an
    ArchiMate model (business, application, technology, motivation, strategy,
    physical or implementation). The vendor-neutral anchor every model element
    ingested by archimate-mcp resolves to.""" ;
    rdfs:seeAlso <https://pubs.opengroup.org/architecture/archimate3-doc/> .

:ArchimateModel a owl:Class ;
    rdfs:label "ArchiMate Model" ;
    rdfs:comment "A whole ArchiMate model (an Open Exchange file) that owns elements, relationships and views." .

:ArchimateRelationship a owl:Class ;
    rdfs:label "ArchiMate Relationship" ;
    rdfs:comment """A reified ArchiMate relationship (Serving, Realization,
    Assignment, Composition, ...) captured as a node so its type, name and
    endpoints are queryable; also projected as a direct LPG edge between the
    endpoint elements.""" .

:ArchimateView a owl:Class ;
    rdfs:label "ArchiMate View" ;
    rdfs:comment "A view (diagram) of an ArchiMate model referencing a subset of its elements and relationships." .

# --- layer classes (subclasses of :ArchimateElement) ---
:StrategyElement a owl:Class ; rdfs:label "Strategy Layer Element" ; rdfs:subClassOf :ArchimateElement .
:BusinessLayerElement a owl:Class ; rdfs:label "Business Layer Element" ; rdfs:subClassOf :ArchimateElement .
:ApplicationLayerElement a owl:Class ; rdfs:label "Application Layer Element" ; rdfs:subClassOf :ArchimateElement .
:TechnologyLayerElement a owl:Class ; rdfs:label "Technology Layer Element" ; rdfs:subClassOf :ArchimateElement .
:PhysicalElement a owl:Class ; rdfs:label "Physical Layer Element" ; rdfs:subClassOf :ArchimateElement .
:MotivationElement a owl:Class ; rdfs:label "Motivation Element" ; rdfs:subClassOf :ArchimateElement .
:ImplementationElement a owl:Class ; rdfs:label "Implementation & Migration Element" ; rdfs:subClassOf :ArchimateElement .
:CompositeElement a owl:Class ; rdfs:label "Composite / Cross-layer Element" ; rdfs:subClassOf :ArchimateElement .


