{
  "mcpServers": {
    "archimate-mcp": {
      "command": "uv",
      "args": [
        "run",
        "archimate-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "intent",
        "ARCHITOOL": "True",
        "ARCHI_KG_INGEST": "1",
        "ARCHI_MODEL_PATH": "./model.archimate"
      }
    }
  }
}
